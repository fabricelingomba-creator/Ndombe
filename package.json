{
  "name": "elongo",
  "private": true,
  "description": "Elongo : plateforme SaaS multi-tenant de gestion des universités",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @elongo/api db:migrate",
    "db:seed": "pnpm --filter @elongo/api db:seed",
    "dev": "pnpm --filter @elongo/api dev"
  }
}
