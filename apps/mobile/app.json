{
  "expo": {
    "name": "Elongo",
    "slug": "elongo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.elongo.mobile",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1D4ED8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.elongo.mobile",
      "allowBackup": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Elongo utilise Face ID pour déverrouiller votre espace."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Elongo utilise Face ID pour déverrouiller votre espace."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Elongo utilise l'appareil photo pour photographier votre bordereau de paiement.",
          "photosPermission": "Elongo accède à vos photos pour joindre votre bordereau de paiement.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sharing"
    ],
    "scheme": "elongo",
    "experiments": {
      "typedRoutes": true
    }
  }
}
