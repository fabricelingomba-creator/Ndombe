# URL interne de l'API Elongo (appelée par le serveur web, jamais par le navigateur).
API_URL=http://localhost:3000

# Clé de chiffrement des cookies de session : 32 caractères minimum, aléatoire.
SESSION_SECRET=remplacer-par-une-valeur-aleatoire-de-32-caracteres-min

# Facultatif : URL de Keycloak vue depuis le serveur web, si elle diffère de l'URL publique
# (par exemple http://keycloak:8080 dans Docker).
KEYCLOAK_INTERNAL_URL=
