# Copier en .env puis adapter. Les valeurs correspondent à docker-compose.yml.
PORT=3000

# Compte propriétaire, utilisé uniquement par les migrations.
DATABASE_OWNER_URL=postgres://postgres:postgres@localhost:5432/elongo
APP_DB_PASSWORD=elongo_app_dev
PLATFORM_DB_PASSWORD=elongo_platform_dev

# Connexions de l'API : rôles soumis à la Row-Level Security.
DATABASE_URL=postgres://elongo_app:elongo_app_dev@localhost:5432/elongo
PLATFORM_DATABASE_URL=postgres://elongo_platform:elongo_platform_dev@localhost:5432/elongo

KEYCLOAK_URL=http://localhost:8080
PLATFORM_REALM=elongo-platform

# <slug>.elongo.localhost résout vers 127.0.0.1 dans la plupart des navigateurs et avec curl.
BASE_DOMAIN=elongo.localhost
TRUST_PROXY_HOPS=0

# Client de service du realm master qui crée les realms des universités
# (voir README, « Création automatique des realms »). Laisser vide pour désactiver.
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Clé de chiffrement des secrets des prestataires de paiement (32 octets en base64) :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Laisser vide pour désactiver les paiements.
PAYMENT_SECRETS_KEY=
# Prestataire « sandbox » (Mobile Money simulé) : actif hors production sauf si false.
PAYMENTS_SANDBOX=

# E-mails de notification : smtp (production), log (journal, défaut en développement)
# ou none (défaut en production si rien n'est indiqué).
EMAIL_TRANSPORT=
# Exemple : smtps://utilisateur:motdepasse@smtp-relay.brevo.com:465 (TLS exigé).
SMTP_URL=
# Adresse d'expédition ; le nom affiché est celui de l'université.
EMAIL_FROM=

# Notifications push vers l'app mobile : expo (défaut en production), log (journal,
# défaut en développement) ou none. Les clés Apple et Firebase sont déposées sur expo.dev.
PUSH_TRANSPORT=
# Seulement si « Enhanced Security for Push Notifications » est activé sur expo.dev.
EXPO_ACCESS_TOKEN=
